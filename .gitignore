# ==========================================================
# ENVIRONMENT & SECRETS
# ==========================================================
#
# Local environment files may contain API keys, database
# credentials, and deployment-specific configuration.
# Only .env.example is safe to version.

.env
.env.*
!.env.example


# ==========================================================
# PYTHON ENVIRONMENTS
# ==========================================================

.venv/
venv/
env/


# ==========================================================
# PYTHON CACHE / BYTECODE
# ==========================================================

__pycache__/
*.py[cod]
*$py.class


# ==========================================================
# PYTHON PACKAGING / BUILD
# ==========================================================

*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/


# ==========================================================
# TESTING / COVERAGE
# ==========================================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

.tox/
.nox/


# ==========================================================
# STATIC ANALYSIS / TOOLING CACHE
# ==========================================================

.mypy_cache/
.ruff_cache/
.pyre/
.pytype/


# ==========================================================
# RUNTIME DATA
# ==========================================================
#
# Managed source documents and other runtime business data
# must never be committed to source control.

storage/


# ==========================================================
# GENERATED OUTPUT
# ==========================================================
#
# Generated runtime, verification, benchmark, migration, or
# maintenance output belongs outside version-controlled
# source files unless explicitly stored under evaluation/.

output/


# ==========================================================
# EVALUATION ARTIFACTS
# ==========================================================
#
# evaluation/ is intentionally versioned.
#
# Synthetic evaluation images, ground truth, reports, and
# archived evaluation results are tracked with the code so
# benchmark results remain reproducible.
#
# Do not add evaluation/ to this file.


# ==========================================================
# LOCAL SAMPLE DOCUMENTS
# ==========================================================
#
# samples/ may contain local, real-world, or otherwise
# sensitive documents and must not be committed.
#
# Safe reproducible fixtures should be kept under the
# version-controlled evaluation dataset instead.

samples/


# ==========================================================
# LOGS
# ==========================================================

*.log
logs/


# ==========================================================
# TEMPORARY FILES
# ==========================================================

*.tmp
*.temp
*.bak


# ==========================================================
# EDITORS / IDEs
# ==========================================================

.idea/
.vscode/
*.swp
*.swo
*~


# ==========================================================
# OPERATING SYSTEM FILES
# ==========================================================

.DS_Store
Thumbs.db
desktop.ini


# ==========================================================
# TLS / CERTIFICATE MATERIAL
# ==========================================================
#
# Runtime TLS certificates and private keys must not be
# committed. The directory README documents the expected
# deployment structure.

docker/nginx/tls/*
!docker/nginx/tls/README.md