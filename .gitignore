# ==========================================================
# SECRETS
# ==========================================================
#
# .env holds GROQ_API_KEY and DATABASE_URL credentials and
# must never be committed. .env.example is the safe template.

.env
.env.*
!.env.example


# ==========================================================
# PYTHON
# ==========================================================

.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ==========================================================
# RUNTIME / GENERATED
# ==========================================================
#
# storage/ holds real managed source documents at runtime.
# It is business data, never source, and must stay out of Git.

storage/

# output/ holds generated benchmark, audit and migration
# artifacts produced by scripts under scripts/.
output/

# Runtime logs, if ever written to disk.
*.log
logs/


# ==========================================================
# EVALUATION ARTIFACTS ARE INTENTIONALLY VERSIONED
# ==========================================================
#
# evaluation/ is NOT ignored.
#
# evaluation/images, ground_truth, results, reports and
# archive are deliberately tracked project artifacts. The
# Phase 6D benchmark numbers are only meaningful if the
# ground truth and the reports they came from are versioned
# alongside the code that produced them.
#
# Do not add evaluation/ here.


# ==========================================================
# LOCAL SAMPLE DOCUMENTS - NOT VERSIONED
# ==========================================================
#
# samples/ is IGNORED deliberately.
#
# A Phase 8 content inspection found that samples/id_card.jpg
# is a photograph of what appears to be a REAL Vietnamese
# national identity card, carrying a 12-digit CCCD number, a
# full name, a date of birth and a specific residential
# address. That is personal data and must never be committed.
#
# samples/ therefore stays ignored in full. Do not add an
# exception for individual files here: a single unsafe image
# in this directory is enough reason to keep the whole
# directory out of Git.
#
# Safe, synthetic, reproducible fixtures live in
# evaluation/images/ and are generated by
# scripts/evaluation/generate_synthetic_documents.py.

samples/


# ==========================================================
# EDITOR / OS
# ==========================================================

.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
