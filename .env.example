# ==========================================================
# VIGILOX DOCUMENT INTELLIGENCE
# ENVIRONMENT TEMPLATE
# ==========================================================
#
# Copy to .env and fill in real values.
#
#     Copy-Item .env.example .env
#
# .env is gitignored and must never be committed.
# ==========================================================


# ----------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------

GROQ_API_KEY=your_groq_api_key_here

DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:PORT_NUMBER/vigilox_document_intelligence


# ----------------------------------------------------------
# OPTIONAL - LOGGING
# ----------------------------------------------------------
# Supported: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Defaults to INFO when unset or unrecognized.

VIGILOX_LOG_LEVEL=INFO


# ----------------------------------------------------------
# OPTIONAL - STORAGE
# ----------------------------------------------------------
# Overrides the managed document storage root.
# Defaults to <project root>/storage/documents.

# DOCUMENT_STORAGE_DIR=


# ----------------------------------------------------------
# OPTIONAL - REVIEWER IDENTITY
# ----------------------------------------------------------
# local_env       : development. Reviewer comes from the two
#                   VIGILOX_LOCAL_REVIEWER_* values below.
#
# trusted_headers : production. Reviewer comes from
#                   X-VIGILOX-REVIEWER-ID and
#                   X-VIGILOX-REVIEWER-ROLE.
#
#                   ONLY use this behind a reverse proxy that
#                   authenticates the user, injects those
#                   headers, and strips any client-supplied
#                   copies. The browser is never authoritative.

VIGILOX_REVIEW_IDENTITY_MODE=local_env

VIGILOX_LOCAL_REVIEWER_ID=local-reviewer

# VIEWER | REVIEWER | ADMIN
VIGILOX_LOCAL_REVIEWER_ROLE=REVIEWER
